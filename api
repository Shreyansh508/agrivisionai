export default async function handler(request, response) {
  const { state, district, commodity } = request.query;

  if (!state || !commodity) {
    return response.status(400).json({ error: 'State and commodity are required.' });
  }

  if (!process.env.DATA_GOV_API_KEY) {
    return response.status(500).json({ error: 'Mandi data service is not configured.' });
  }

  const parameters = new URLSearchParams({
    'api-key': process.env.DATA_GOV_API_KEY,
    format: 'json',
    limit: '100',
    'filters[state]': state,
    'filters[commodity]': commodity
  });
  if (district) parameters.set('filters[district]', district);

  try {
    const mandiResponse = await fetch(
      `https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070?${parameters}`
    );
    if (!mandiResponse.ok) throw new Error('The government price service is unavailable.');

    const payload = await mandiResponse.json();
    response.setHeader('Cache-Control', 's-maxage=900, stale-while-revalidate=3600');
    return response.status(200).json({ records: payload.records || [] });
  } catch (error) {
    return response.status(502).json({ error: 'Unable to load official mandi prices.' });
  }
}
